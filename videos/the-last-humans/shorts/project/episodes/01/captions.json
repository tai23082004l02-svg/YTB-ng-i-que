[
  {
    "start": 0.35,
    "end": 2.625,
    "text": "Fifty thousand years ago, meeting"
  },
  {
    "start": 2.625,
    "end": 4.5,
    "text": "another human did not always"
  },
  {
    "start": 4.5,
    "end": 5.775,
    "text": "mean meeting someone from your"
  },
  {
    "start": 5.775,
    "end": 6.9,
    "text": "species."
  },
  {
    "start": 7.35,
    "end": 9.1125,
    "text": "Homo sapiens shared parts of"
  },
  {
    "start": 9.1125,
    "end": 10.6125,
    "text": "the prehistoric world with"
  },
  {
    "start": 10.6125,
    "end": 12.4375,
    "text": "other human lineages."
  },
  {
    "start": 12.4375,
    "end": 14.2625,
    "text": "Neanderthals lived across parts"
  },
  {
    "start": 14.2625,
    "end": 15.8375,
    "text": "of Europe and Asia."
  },
  {
    "start": 15.8375,
    "end": 17.4375,
    "text": "Denisovan-related groups had"
  },
  {
    "start": 17.4375,
    "end": 19.25,
    "text": "their own complicated Asian"
  },
  {
    "start": 19.25,
    "end": 21.6125,
    "text": "history. Small-bodied humans"
  },
  {
    "start": 21.6125,
    "end": 23.625,
    "text": "also lived on Flores."
  },
  {
    "start": 24.025000000000002,
    "end": 25.675,
    "text": "But this was not one giant"
  },
  {
    "start": 25.675,
    "end": 28.075000000000003,
    "text": "reunion. Different groups occupied"
  },
  {
    "start": 28.075000000000003,
    "end": 29.6125,
    "text": "different places, and their"
  },
  {
    "start": 29.6125,
    "end": 31.475,
    "text": "known dates do not put everyone"
  },
  {
    "start": 31.475,
    "end": 33.5,
    "text": "beside the same campfire."
  },
  {
    "start": 33.925000000000004,
    "end": 36.225,
    "text": "Today, every living human belongs"
  },
  {
    "start": 36.225,
    "end": 37.9125,
    "text": "to Homo sapiens."
  },
  {
    "start": 37.9125,
    "end": 39.3125,
    "text": "That does not make the past"
  },
  {
    "start": 39.3125,
    "end": 40.862500000000004,
    "text": "a tournament where every other"
  },
  {
    "start": 40.862500000000004,
    "end": 42.7,
    "text": "branch was inferior."
  },
  {
    "start": 43.175,
    "end": 44.7125,
    "text": "Some relatives disappeared"
  },
  {
    "start": 44.7125,
    "end": 46.75,
    "text": "as distinct populations."
  },
  {
    "start": 46.75,
    "end": 48.912499999999994,
    "text": "Some also contributed ancestry"
  },
  {
    "start": 48.912499999999994,
    "end": 51.074999999999996,
    "text": "to later people through interbreeding."
  },
  {
    "start": 51.675000000000004,
    "end": 53.425000000000004,
    "text": "We are the only human species"
  },
  {
    "start": 53.425000000000004,
    "end": 54.650000000000006,
    "text": "alive today."
  },
  {
    "start": 54.650000000000006,
    "end": 56.6625,
    "text": "Our family history still contains"
  },
  {
    "start": 56.6625,
    "end": 58.45,
    "text": "more than one kind of human."
  }
]