[
  {
    "start": 0.325,
    "end": 2.25,
    "text": "Did our ancestors kill every"
  },
  {
    "start": 2.25,
    "end": 3.8,
    "text": "other kind of human?"
  },
  {
    "start": 4.225,
    "end": 5.5625,
    "text": "We do not have evidence for"
  },
  {
    "start": 5.5625,
    "end": 8.15,
    "text": "one coordinated global extermination"
  },
  {
    "start": 8.15,
    "end": 9.225,
    "text": "campaign."
  },
  {
    "start": 9.674999999999999,
    "end": 12.625,
    "text": "As Homo sapiens expanded, competition"
  },
  {
    "start": 12.625,
    "end": 14.85,
    "text": "for food, shelter, and territory"
  },
  {
    "start": 14.85,
    "end": 16.95,
    "text": "could affect other populations."
  },
  {
    "start": 16.95,
    "end": 19.075,
    "text": "Violence is possible too."
  },
  {
    "start": 19.075,
    "end": 20.35,
    "text": "But different encounters"
  },
  {
    "start": 20.35,
    "end": 22.1,
    "text": "could have different outcomes."
  },
  {
    "start": 22.75,
    "end": 24.075,
    "text": "Some groups may have avoided"
  },
  {
    "start": 24.075,
    "end": 25.025,
    "text": "one another."
  },
  {
    "start": 25.025,
    "end": 27.1,
    "text": "Some may have exchanged knowledge."
  },
  {
    "start": 27.1,
    "end": 28.85,
    "text": "Genetic evidence shows that"
  },
  {
    "start": 28.85,
    "end": 30.675,
    "text": "some had children together."
  },
  {
    "start": 31.3,
    "end": 32.85,
    "text": "Environmental pressure and"
  },
  {
    "start": 32.85,
    "end": 35.45,
    "text": "small, isolated populations"
  },
  {
    "start": 35.45,
    "end": 36.9375,
    "text": "could also make competition"
  },
  {
    "start": 36.9375,
    "end": 38.675,
    "text": "harder to withstand."
  },
  {
    "start": 39.125,
    "end": 40.475,
    "text": "That leaves a more difficult"
  },
  {
    "start": 40.475,
    "end": 42.475,
    "text": "question: how did these factors"
  },
  {
    "start": 42.475,
    "end": 44.4,
    "text": "interact in different places?"
  },
  {
    "start": 44.975,
    "end": 46.375,
    "text": "It would be wrong to declare"
  },
  {
    "start": 46.375,
    "end": 48.75,
    "text": "our ancestors uninvolved."
  },
  {
    "start": 48.75,
    "end": 50.425,
    "text": "It would also be wrong to turn"
  },
  {
    "start": 50.425,
    "end": 51.8,
    "text": "every disappearance into the"
  },
  {
    "start": 51.8,
    "end": 54.025,
    "text": "same proven murder story."
  },
  {
    "start": 54.45,
    "end": 55.7125,
    "text": "The evidence points toward"
  },
  {
    "start": 55.7125,
    "end": 58.125,
    "text": "a complicated history of contact,"
  },
  {
    "start": 58.125,
    "end": 59.925,
    "text": "rather than one worldwide"
  },
  {
    "start": 59.925,
    "end": 62.0375,
    "text": "event with a single demonstrated"
  },
  {
    "start": 62.0375,
    "end": 63.0,
    "text": "cause."
  }
]