[
  {
    "start": 0.375,
    "end": 2.0,
    "text": "One tiny bone helped reveal"
  },
  {
    "start": 2.0,
    "end": 4.0,
    "text": "an entire human lineage."
  },
  {
    "start": 4.475,
    "end": 5.975,
    "text": "A finger-bone fragment from"
  },
  {
    "start": 5.975,
    "end": 8.225,
    "text": "Denisova Cave, in Siberia,"
  },
  {
    "start": 8.225,
    "end": 10.5625,
    "text": "contained ancient DNA."
  },
  {
    "start": 10.5625,
    "end": 12.299999999999999,
    "text": "When researchers analyzed it,"
  },
  {
    "start": 12.299999999999999,
    "end": 13.924999999999999,
    "text": "the genetic evidence pointed"
  },
  {
    "start": 13.924999999999999,
    "end": 15.9125,
    "text": "to a previously unrecognized"
  },
  {
    "start": 15.9125,
    "end": 18.525,
    "text": "archaic group: the Denisovans."
  },
  {
    "start": 19.15,
    "end": 20.95,
    "text": "Usually, a fossil's appearance"
  },
  {
    "start": 20.95,
    "end": 22.299999999999997,
    "text": "starts the argument about its"
  },
  {
    "start": 22.299999999999997,
    "end": 24.987499999999997,
    "text": "relatives. Here, genetics opened"
  },
  {
    "start": 24.987499999999997,
    "end": 26.224999999999998,
    "text": "a different door."
  },
  {
    "start": 26.7,
    "end": 28.8,
    "text": "Later fossils and genetic findings"
  },
  {
    "start": 28.8,
    "end": 30.5625,
    "text": "expanded the story."
  },
  {
    "start": 30.5625,
    "end": 32.5375,
    "text": "Denisovan-related ancestry"
  },
  {
    "start": 32.5375,
    "end": 34.575,
    "text": "is not confined to one cave"
  },
  {
    "start": 34.575,
    "end": 37.625,
    "text": "or one identical ancient population."
  },
  {
    "start": 38.175,
    "end": 40.2375,
    "text": "But DNA does not hand us a"
  },
  {
    "start": 40.2375,
    "end": 41.4375,
    "text": "photograph."
  },
  {
    "start": 41.4375,
    "end": 42.9625,
    "text": "Confident-looking Denisovan"
  },
  {
    "start": 42.9625,
    "end": 44.8125,
    "text": "faces in illustrations are"
  },
  {
    "start": 44.8125,
    "end": 46.8,
    "text": "artistic reconstructions."
  },
  {
    "start": 47.225,
    "end": 48.925,
    "text": "The discovery is remarkable"
  },
  {
    "start": 48.925,
    "end": 50.7875,
    "text": "without inventing their appearance"
  },
  {
    "start": 50.7875,
    "end": 52.4,
    "text": "or personal lives."
  },
  {
    "start": 52.85,
    "end": 54.6375,
    "text": "A branch of the human family"
  },
  {
    "start": 54.6375,
    "end": 56.2,
    "text": "can be difficult to recognize"
  },
  {
    "start": 56.2,
    "end": 58.475,
    "text": "in bones, yet leave evidence"
  },
  {
    "start": 58.475,
    "end": 60.275,
    "text": "in the ancestry of people living"
  },
  {
    "start": 60.275,
    "end": 61.925,
    "text": "far away today."
  }
]