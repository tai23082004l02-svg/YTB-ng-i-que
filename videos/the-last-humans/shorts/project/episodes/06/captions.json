[
  {
    "start": 0.35,
    "end": 2.3,
    "text": "This ancient human was an adult,"
  },
  {
    "start": 2.3,
    "end": 3.675,
    "text": "not a child."
  },
  {
    "start": 4.175,
    "end": 6.975,
    "text": "One individual of Homo floresiensis,"
  },
  {
    "start": 6.975,
    "end": 8.7375,
    "text": "discovered on the Indonesian"
  },
  {
    "start": 8.7375,
    "end": 11.125,
    "text": "island of Flores, is estimated"
  },
  {
    "start": 11.125,
    "end": 12.262500000000001,
    "text": "to have stood about three and"
  },
  {
    "start": 12.262500000000001,
    "end": 13.775,
    "text": "a half feet tall."
  },
  {
    "start": 14.225,
    "end": 16.1375,
    "text": "These small-bodied humans had"
  },
  {
    "start": 16.1375,
    "end": 17.7875,
    "text": "a distinctive combination of"
  },
  {
    "start": 17.7875,
    "end": 19.55,
    "text": "anatomical traits."
  },
  {
    "start": 19.55,
    "end": 20.875,
    "text": "They were not simply modern"
  },
  {
    "start": 20.875,
    "end": 22.95,
    "text": "people waiting to grow taller."
  },
  {
    "start": 23.55,
    "end": 25.287499999999998,
    "text": "Their evolutionary origins"
  },
  {
    "start": 25.287499999999998,
    "end": 26.849999999999998,
    "text": "remain debated."
  },
  {
    "start": 26.849999999999998,
    "end": 28.75,
    "text": "Island environments can reshape"
  },
  {
    "start": 28.75,
    "end": 30.6,
    "text": "populations, but that does"
  },
  {
    "start": 30.6,
    "end": 32.225,
    "text": "not settle the exact route"
  },
  {
    "start": 32.225,
    "end": 33.575,
    "text": "that produced them."
  },
  {
    "start": 34.025,
    "end": 36.025,
    "text": "Stone tools also warn us against"
  },
  {
    "start": 36.025,
    "end": 38.4,
    "text": "treating a small body or brain"
  },
  {
    "start": 38.4,
    "end": 40.525,
    "text": "as a shortcut for judging practical"
  },
  {
    "start": 40.525,
    "end": 41.525,
    "text": "ability."
  },
  {
    "start": 41.95,
    "end": 44.225,
    "text": "Their ending remains uncertain."
  },
  {
    "start": 44.225,
    "end": 46.2375,
    "text": "The youngest fossil discovered"
  },
  {
    "start": 46.2375,
    "end": 48.125,
    "text": "is not automatically the last"
  },
  {
    "start": 48.125,
    "end": 49.775,
    "text": "individual who lived."
  },
  {
    "start": 50.225,
    "end": 52.0875,
    "text": "Flores gives us a remarkable"
  },
  {
    "start": 52.0875,
    "end": 54.15,
    "text": "human relative, and questions"
  },
  {
    "start": 54.15,
    "end": 55.55,
    "text": "about its history."
  },
  {
    "start": 55.55,
    "end": 57.0375,
    "text": "It does not give us a solved"
  },
  {
    "start": 57.0375,
    "end": 59.225,
    "text": "case with an identified killer."
  }
]