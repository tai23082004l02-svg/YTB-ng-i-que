[
  {
    "start": 0.35,
    "end": 1.9,
    "text": "A meeting between ancient human"
  },
  {
    "start": 1.9,
    "end": 4.3375,
    "text": "lineages helped leave an inheritance"
  },
  {
    "start": 4.3375,
    "end": 6.65,
    "text": "useful at high altitude."
  },
  {
    "start": 7.125,
    "end": 9.1,
    "text": "Research on a DNA region near"
  },
  {
    "start": 9.1,
    "end": 12.1875,
    "text": "the gene called E P A S one"
  },
  {
    "start": 12.1875,
    "end": 14.2625,
    "text": "found evidence of a Denisovan-related"
  },
  {
    "start": 14.2625,
    "end": 16.575,
    "text": "version in Tibetan ancestry."
  },
  {
    "start": 17.175,
    "end": 19.5,
    "text": "That inherited region was favored"
  },
  {
    "start": 19.5,
    "end": 21.275,
    "text": "in an environment where oxygen"
  },
  {
    "start": 21.275,
    "end": 23.1,
    "text": "availability is low."
  },
  {
    "start": 23.525,
    "end": 25.2375,
    "text": "It is a striking example of"
  },
  {
    "start": 25.2375,
    "end": 26.675,
    "text": "interbreeding contributing"
  },
  {
    "start": 26.675,
    "end": 28.5,
    "text": "to later adaptation."
  },
  {
    "start": 28.925,
    "end": 30.637500000000003,
    "text": "But one gene does not explain"
  },
  {
    "start": 30.637500000000003,
    "end": 33.275,
    "text": "every aspect of Tibetan physiology."
  },
  {
    "start": 33.275,
    "end": 35.45,
    "text": "Environment, other genes,"
  },
  {
    "start": 35.45,
    "end": 37.475,
    "text": "and population history matter"
  },
  {
    "start": 37.475,
    "end": 39.7875,
    "text": "too. Nor does this result give"
  },
  {
    "start": 39.7875,
    "end": 41.337500000000006,
    "text": "us a complete biography of"
  },
  {
    "start": 41.337500000000006,
    "end": 43.375,
    "text": "the ancient group that contributed"
  },
  {
    "start": 43.375,
    "end": 44.675,
    "text": "the DNA."
  },
  {
    "start": 45.125,
    "end": 46.762499999999996,
    "text": "Genetic evidence can preserve"
  },
  {
    "start": 46.762499999999996,
    "end": 48.262499999999996,
    "text": "traces of a meeting across"
  },
  {
    "start": 48.262499999999996,
    "end": 50.3125,
    "text": "human lineages, long after"
  },
  {
    "start": 50.3125,
    "end": 52.324999999999996,
    "text": "the people themselves are gone."
  },
  {
    "start": 52.925000000000004,
    "end": 54.612500000000004,
    "text": "An extinct branch can leave"
  },
  {
    "start": 54.612500000000004,
    "end": 56.050000000000004,
    "text": "more than a fossil."
  },
  {
    "start": 56.050000000000004,
    "end": 57.975,
    "text": "Sometimes it leaves an inheritance"
  },
  {
    "start": 57.975,
    "end": 59.8125,
    "text": "that remains useful in a very"
  },
  {
    "start": 59.8125,
    "end": 61.150000000000006,
    "text": "different future."
  }
]