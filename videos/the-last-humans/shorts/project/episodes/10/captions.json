[
  {
    "start": 0.35,
    "end": 1.9375,
    "text": "Neanderthals disappeared as"
  },
  {
    "start": 1.9375,
    "end": 3.8875,
    "text": "a distinct population, but"
  },
  {
    "start": 3.8875,
    "end": 6.05,
    "text": "some of their ancestry continued."
  },
  {
    "start": 6.7,
    "end": 8.9625,
    "text": "Many people with ancestry outside"
  },
  {
    "start": 8.9625,
    "end": 11.05,
    "text": "Africa carry roughly one to"
  },
  {
    "start": 11.05,
    "end": 13.7,
    "text": "two percent Neanderthal ancestry."
  },
  {
    "start": 13.7,
    "end": 16.0,
    "text": "The estimates vary by population"
  },
  {
    "start": 16.0,
    "end": 16.975,
    "text": "and method."
  },
  {
    "start": 17.4,
    "end": 19.037499999999998,
    "text": "The geography is also more"
  },
  {
    "start": 19.037499999999998,
    "end": 21.35,
    "text": "complicated than a clean split:"
  },
  {
    "start": 21.35,
    "end": 23.4125,
    "text": "later migrations helped bring"
  },
  {
    "start": 23.4125,
    "end": 25.525,
    "text": "Neanderthal-related ancestry"
  },
  {
    "start": 25.525,
    "end": 27.825,
    "text": "into some African populations."
  },
  {
    "start": 28.4,
    "end": 30.4,
    "text": "The reason is interbreeding."
  },
  {
    "start": 30.4,
    "end": 32.175,
    "text": "Some children of encounters"
  },
  {
    "start": 32.175,
    "end": 33.8375,
    "text": "between sapiens and archaic"
  },
  {
    "start": 33.8375,
    "end": 35.5,
    "text": "groups had descendants who"
  },
  {
    "start": 35.5,
    "end": 37.9,
    "text": "contributed to later populations."
  },
  {
    "start": 38.5,
    "end": 40.1,
    "text": "That does not make anyone alive"
  },
  {
    "start": 40.1,
    "end": 42.175,
    "text": "today a different human species."
  },
  {
    "start": 42.175,
    "end": 43.9375,
    "text": "All living people are Homo"
  },
  {
    "start": 43.9375,
    "end": 45.025,
    "text": "sapiens."
  },
  {
    "start": 45.45,
    "end": 46.9625,
    "text": "And an ancestry percentage"
  },
  {
    "start": 46.9625,
    "end": 49.0,
    "text": "is not a ranking of intelligence,"
  },
  {
    "start": 49.0,
    "end": 51.325,
    "text": "worth, or authenticity."
  },
  {
    "start": 51.75,
    "end": 53.8,
    "text": "The surprising part is simpler:"
  },
  {
    "start": 53.8,
    "end": 55.875,
    "text": "a distinct branch can disappear"
  },
  {
    "start": 55.875,
    "end": 57.525,
    "text": "while pieces of its ancestry"
  },
  {
    "start": 57.525,
    "end": 59.175,
    "text": "continue elsewhere."
  },
  {
    "start": 59.625,
    "end": 61.375,
    "text": "Replacement and mixture can"
  },
  {
    "start": 61.375,
    "end": 63.1,
    "text": "both belong to the same human"
  },
  {
    "start": 63.1,
    "end": 64.05,
    "text": "history."
  }
]