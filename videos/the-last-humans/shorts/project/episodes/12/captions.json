[
  {
    "start": 0.35,
    "end": 1.6125,
    "text": "Farming did not make us the"
  },
  {
    "start": 1.6125,
    "end": 3.925,
    "text": "last surviving human species."
  },
  {
    "start": 4.55,
    "end": 6.387499999999999,
    "text": "Neanderthals disappeared around"
  },
  {
    "start": 6.387499999999999,
    "end": 8.475,
    "text": "forty thousand years ago."
  },
  {
    "start": 8.475,
    "end": 10.125,
    "text": "Agriculture began spreading"
  },
  {
    "start": 10.125,
    "end": 12.412500000000001,
    "text": "much later, with major developments"
  },
  {
    "start": 12.412500000000001,
    "end": 14.0,
    "text": "roughly twelve thousand years"
  },
  {
    "start": 14.0,
    "end": 15.75,
    "text": "ago in some regions."
  },
  {
    "start": 16.2,
    "end": 17.725,
    "text": "Those dates are approximate,"
  },
  {
    "start": 17.725,
    "end": 19.2125,
    "text": "and farming did not begin"
  },
  {
    "start": 19.2125,
    "end": 20.7875,
    "text": "everywhere at once."
  },
  {
    "start": 20.7875,
    "end": 22.1375,
    "text": "The important point is the"
  },
  {
    "start": 22.1375,
    "end": 24.825,
    "text": "gap: tens of thousands of years."
  },
  {
    "start": 25.45,
    "end": 27.175,
    "text": "Cities, writing, and modern"
  },
  {
    "start": 27.175,
    "end": 29.15,
    "text": "industry came later still."
  },
  {
    "start": 29.6,
    "end": 31.225,
    "text": "Our ancestors were already"
  },
  {
    "start": 31.225,
    "end": 33.75,
    "text": "the only surviving human species"
  },
  {
    "start": 33.75,
    "end": 35.2,
    "text": "before they built the things"
  },
  {
    "start": 35.2,
    "end": 37.225,
    "text": "we often use to explain human"
  },
  {
    "start": 37.225,
    "end": 38.325,
    "text": "success."
  },
  {
    "start": 38.775,
    "end": 41.0,
    "text": "Their survival has to be investigated"
  },
  {
    "start": 41.0,
    "end": 42.699999999999996,
    "text": "through earlier environments,"
  },
  {
    "start": 42.699999999999996,
    "end": 44.9,
    "text": "population history, social"
  },
  {
    "start": 44.9,
    "end": 46.75,
    "text": "connections, expansion, and"
  },
  {
    "start": 46.75,
    "end": 47.875,
    "text": "interbreeding."
  },
  {
    "start": 48.35,
    "end": 50.0125,
    "text": "None of those factors supplies"
  },
  {
    "start": 50.0125,
    "end": 51.6375,
    "text": "one proven answer for every"
  },
  {
    "start": 51.6375,
    "end": 52.525,
    "text": "place."
  },
  {
    "start": 52.95,
    "end": 54.2875,
    "text": "We tell this story from the"
  },
  {
    "start": 54.2875,
    "end": 55.9125,
    "text": "surviving branch."
  },
  {
    "start": 55.9125,
    "end": 57.5875,
    "text": "That can make its outcome feel"
  },
  {
    "start": 57.5875,
    "end": 59.45,
    "text": "inevitable, even when people"
  },
  {
    "start": 59.45,
    "end": 60.925,
    "text": "living through it had no way"
  },
  {
    "start": 60.925,
    "end": 62.325,
    "text": "to know the ending."
  }
]