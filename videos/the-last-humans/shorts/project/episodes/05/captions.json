[
  {
    "start": 0.325,
    "end": 2.025,
    "text": "Her mother was Neanderthal."
  },
  {
    "start": 2.025,
    "end": 3.95,
    "text": "Her father was Denisovan."
  },
  {
    "start": 4.575,
    "end": 6.65,
    "text": "In twenty eighteen, researchers"
  },
  {
    "start": 6.65,
    "end": 8.3,
    "text": "reported genetic evidence from"
  },
  {
    "start": 8.3,
    "end": 10.275,
    "text": "a young individual represented"
  },
  {
    "start": 10.275,
    "end": 12.3125,
    "text": "by a bone fragment from Denisova"
  },
  {
    "start": 12.3125,
    "end": 13.274999999999999,
    "text": "Cave."
  },
  {
    "start": 13.725,
    "end": 15.7,
    "text": "This was direct first-generation"
  },
  {
    "start": 15.7,
    "end": 17.7,
    "text": "parentage, not just a faint"
  },
  {
    "start": 17.7,
    "end": 19.6125,
    "text": "signal of mixing many generations"
  },
  {
    "start": 19.6125,
    "end": 20.6,
    "text": "earlier."
  },
  {
    "start": 21.025,
    "end": 22.349999999999998,
    "text": "The discovery made something"
  },
  {
    "start": 22.349999999999998,
    "end": 24.5,
    "text": "abstract suddenly personal:"
  },
  {
    "start": 24.5,
    "end": 26.225,
    "text": "boundaries between ancient"
  },
  {
    "start": 26.225,
    "end": 27.9375,
    "text": "human groups were not always"
  },
  {
    "start": 27.9375,
    "end": 29.0,
    "text": "absolute."
  },
  {
    "start": 29.425,
    "end": 30.762500000000003,
    "text": "We do not know the family's"
  },
  {
    "start": 30.762500000000003,
    "end": 32.6,
    "text": "language, how the parents met,"
  },
  {
    "start": 32.6,
    "end": 34.925000000000004,
    "text": "or the story of their relationship."
  },
  {
    "start": 34.925000000000004,
    "end": 37.2,
    "text": "A family portrait is imagined;"
  },
  {
    "start": 37.2,
    "end": 38.5125,
    "text": "the parentage comes from"
  },
  {
    "start": 38.5125,
    "end": 39.675,
    "text": "DNA."
  },
  {
    "start": 40.1,
    "end": 41.887499999999996,
    "text": "It also does not mean every"
  },
  {
    "start": 41.887499999999996,
    "end": 43.4125,
    "text": "ancient group interbred with"
  },
  {
    "start": 43.4125,
    "end": 45.225,
    "text": "every other group, or that"
  },
  {
    "start": 45.225,
    "end": 47.275,
    "text": "every encounter was peaceful."
  },
  {
    "start": 47.824999999999996,
    "end": 49.3,
    "text": "But it does mean a diagram"
  },
  {
    "start": 49.3,
    "end": 51.512499999999996,
    "text": "of cleanly separated branches"
  },
  {
    "start": 51.512499999999996,
    "end": 53.625,
    "text": "leaves out some real families."
  },
  {
    "start": 54.2,
    "end": 55.85,
    "text": "Human evolution has a family"
  },
  {
    "start": 55.85,
    "end": 57.9875,
    "text": "history that the simplest family"
  },
  {
    "start": 57.9875,
    "end": 59.975,
    "text": "tree cannot fully show."
  }
]